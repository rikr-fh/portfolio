---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const cases = (await getCollection('werk')).sort((a, b) => a.data.nr.localeCompare(b.data.nr));
  return cases.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, vorige: cases[i - 1], volgende: cases[i + 1] },
  }));
}

const { entry, vorige, volgende } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.titel} description={d.samenvatting} section="werk">
  <article class="wrap case">
    <a class="r-btn r-btn--ghost terug" href="/#werk"><span aria-hidden="true">←</span> Werk</a>

    <header class="kop">
      <p class="r-label">{d.domein}{d.concept && <span class="r-tag r-tag--highlight">Concept</span>}</p>
      <h1>{d.titel}</h1>
      <p class="lead">{d.samenvatting}</p>
      <dl class="spec">
        <div><dt class="r-label">Domein</dt><dd>{d.domein}</dd></div>
        <div><dt class="r-label">Rol</dt><dd>{d.rol}</dd></div>
        <div><dt class="r-label">Jaar</dt><dd>{d.jaar}</dd></div>
      </dl>
    </header>

    <div class="beeld"><span class="r-label">Beeld volgt</span></div>

    <div class="prose">
      <Content />
    </div>

    <nav class="verder" aria-label="Meer werk">
      {vorige ? <a href={`/werk/${vorige.id}/`}><span class="r-label"><span aria-hidden="true">←</span> Vorige</span><span class="titel">{vorige.data.titel}</span></a> : <span></span>}
      {volgende ? <a class="rechts" href={`/werk/${volgende.id}/`}><span class="r-label">Volgende <span aria-hidden="true">→</span></span><span class="titel">{volgende.data.titel}</span></a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .case { padding-top: clamp(24px, 4vw, 40px); }
  .terug { min-height: 44px; margin-left: -4px; }
  .kop { margin-top: var(--space-6); max-width: 820px; }
  .kop .r-label { display: flex; align-items: center; gap: 12px; }
  h1 { font: 720 2.5rem/1.08 var(--font-display); font-stretch: 112%; letter-spacing: -.028em; margin: var(--space-4) 0; }
  .lead { font: 400 1.25rem/1.5 var(--font-sans); color: var(--ink-muted); max-width: 34em; }
  .spec { display: grid; grid-template-columns: repeat(3, minmax(0, 200px)); gap: var(--space-6); margin-top: 32px; }
  .spec div { border-top: var(--hairline) solid var(--line-strong); padding-top: 10px; display: flex; flex-direction: column; gap: 6px; }
  .spec dd { font: 400 0.9375rem/1.4 var(--font-sans); }

  .beeld { margin-top: clamp(40px, 6vw, 64px); aspect-ratio: 16 / 9; max-height: 520px; width: 100%; display: grid; place-items: center; background: var(--surface-200); }

  .prose { margin-top: clamp(40px, 6vw, 64px); max-width: 36em; }
  .prose :global(h2) { font: 650 1.5rem/1.2 var(--font-display); font-stretch: 104%; letter-spacing: -.018em; margin: 40px 0 12px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font: 620 1.125rem/1.33 var(--font-display); letter-spacing: -.01em; margin: 28px 0 8px; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin-bottom: var(--space-4); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; }
  .prose :global(a) { color: var(--signal-ink); text-underline-offset: 3px; }
  .prose :global(img) { margin: var(--space-6) 0; }
  .prose :global(blockquote) { margin: var(--space-6) 0; padding-left: var(--space-4); border-left: 2px solid var(--ink); font-size: 1.25rem; line-height: 1.5; }

  .verder { margin-top: var(--section); border-top: var(--hairline) solid var(--ink); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  .verder a { display: flex; flex-direction: column; gap: 6px; padding: 18px 0; text-decoration: none; }
  .verder .rechts { text-align: right; align-items: flex-end; }
  .verder .titel { font: 620 1.125rem/1.33 var(--font-display); letter-spacing: -.01em; }
  .verder a:hover .titel { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .verder a:hover .r-label { color: var(--signal-ink); }

  @media (max-width: 560px) {
    h1 { font-size: 2rem; line-height: 1.19; }
    .spec { grid-template-columns: 1fr 1fr; }
    .verder { grid-template-columns: 1fr; gap: 0; }
    .verder .rechts { text-align: left; align-items: flex-start; border-top: var(--hairline) solid var(--line); }
  }
</style>
