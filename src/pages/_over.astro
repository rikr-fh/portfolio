---
import Base from '../layouts/Base.astro';
import Ervaring from '../components/Ervaring.astro';
import Achtergrond from '../components/Achtergrond.astro';
import Werkwijze from '../components/Werkwijze.astro';
import { Image } from 'astro:assets';
import portret from '../assets/portret.jpg';
import { site } from '../data/site';
---
<Base title="Over" section="over" description={`Over ${site.name}, ${site.role} bij ${site.employer.name}: ervaring, werkwijze en waar ik op let.`}>
  <div class="wrap over">
    <div class="tekst">
      <p class="r-label">Over</p>
      <h1>Ik maak de toekomst tastbaar.</h1>
      <p class="lead">Ik ben {site.name}, {site.role} bij {site.employer.name} in {site.employer.place}. Ik ontwerp digitale producten die eenvoudig zijn — en geruststellend waar het spannend wordt.</p>
      <p>Van onderzoek en strategie tot interactieve prototypes, ik werk samen om het beste resultaat te bereiken.</p>
    </div>
    <div class="beeld"><Image src={portret} alt={`Portret van ${site.name}`} widths={[240, 360, 480]} sizes="(max-width: 760px) 320px, 420px" loading="eager" /></div>
  </div>

  <Ervaring />
  <Achtergrond />
  <Werkwijze />
</Base>

<style>
  .over { padding-top: clamp(40px, 6vw, 72px); display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  h1 { font: 720 2.5rem/1.08 var(--font-display); font-stretch: 112%; letter-spacing: -.028em; margin: var(--space-4) 0 var(--space-6); max-width: 14ch; }
  .lead { font: 400 1.25rem/1.5 var(--font-sans); margin-bottom: var(--space-4); max-width: 34em; }
  .tekst p:not(.r-label):not(.lead) { color: var(--ink-muted); max-width: 36em; }
  .over { align-items: center; }
  .beeld { aspect-ratio: 1; background: var(--surface-200); }
  .beeld :global(img) { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 760px) {
    .over { grid-template-columns: 1fr; }
    .beeld { max-width: 320px; }
    h1 { font-size: 2rem; line-height: 1.19; }
  }
</style>
