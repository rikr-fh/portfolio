---
// Pijl als SVG, zodat iOS er geen emoji van maakt (dat gebeurt met ↗ als tekstteken).
// Dezelfde lijndikte en uiteinden als het uitklap-pijltje in de accordeon.
interface Props { richting?: 'rechts' | 'links' | 'uit'; class?: string; }
const { richting = 'rechts', class: cls } = Astro.props;
const pad = {
  rechts: 'M3.5 10h13M11.5 5l5 5-5 5',
  links: 'M16.5 10h-13M8.5 5l-5 5 5 5',
  uit: 'M6 14L14 6M7.5 6H14v6.5',
}[richting];
---
<svg class:list={['pijl', richting === 'uit' ? 'arrow arrow--out' : 'arrow', cls]} width="1em" height="1em" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d={pad} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
