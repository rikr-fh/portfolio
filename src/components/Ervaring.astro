---
// Ervaring. Breed: tabel met alles zichtbaar. Smal: accordeon, één rol tegelijk open.
import { ervaring } from '../data/ervaring';
---
<section class="wrap sec" id="ervaring" aria-labelledby="ervaring-kop">
  <h2 class="sec-kop" id="ervaring-kop">Ervaring</h2>
  <ol class="lijst" data-accordeon="ervaring">
    {ervaring.map((e) => (
      <li>
        <details open>
          <summary>
            <span class="periode">{e.periode}</span>
            <h3>{e.rol}{e.concept && <span class="r-tag r-tag--highlight">Aanvullen</span>}</h3>
            <span class="org">{e.organisatie}</span>
            <svg class="ind" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </summary>
          {e.tekst && <p>{e.tekst}</p>}
        </details>
      </li>
    ))}
  </ol>
</section>

<script>
  import '../scripts/accordeon';
</script>

<style>
  .lijst { margin: 0; border-top: var(--hairline) solid var(--ink); }
  li { border-bottom: var(--hairline) solid var(--line); }
  summary { display: grid; grid-template-columns: 160px 1.6fr 1fr; gap: var(--space-4) var(--space-6); align-items: baseline; padding: 18px 12px 0; }
  .periode { font: 400 0.9375rem/1.47 var(--font-sans); font-variant-numeric: tabular-nums; color: var(--ink-muted); }
  h3 { font: 620 1.125rem/1.33 var(--font-display); letter-spacing: -.01em; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .org { font: 400 0.875rem/1.43 var(--font-sans); color: var(--ink-muted); }
  p { font: 400 0.9375rem/1.47 var(--font-sans); color: var(--ink-muted); max-width: 560px; margin: 6px 12px 18px calc(12px + 160px + var(--space-6)); }

  @media (max-width: 760px) {
    summary {
      grid-template-columns: 1fr 20px; grid-template-areas: "periode ind" "rol ind" "org ind";
      gap: 2px var(--space-4); align-items: center; padding: 16px 0;
    }
    .periode { grid-area: periode; font-size: 0.875rem; }
    h3 { grid-area: rol; }
    .org { grid-area: org; }
    .ind { grid-area: ind; }
    p { margin: 0 36px 18px 0; font-size: 1rem; line-height: 1.5; }
  }
</style>
