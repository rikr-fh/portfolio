---
import { site } from '../data/site';
---
<section class="wrap sec" aria-label="Werkwijze">
  <div class="cols">
    {site.werkwijze.map((kolom) => (
      <div>
        <h2>{kolom.label}</h2>
        <ul class="items">{kolom.items.map((item) => <li>{item}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<style>
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .cols > div { border-top: var(--hairline) solid var(--ink); padding-top: var(--space-4); }
  h2 { font: 620 1.125rem/1.33 var(--font-display); letter-spacing: -.01em; }
  .items { margin-top: 12px; }
  .items li { font: 400 1rem/1.6 var(--font-sans); color: var(--ink-muted); }

  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
