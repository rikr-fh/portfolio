---
// Projectkaart. Standaard voor het raster; `featured` als breed paneel, één keer per pagina.
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'werk'>; featured?: boolean; }
const { entry, featured = false } = Astro.props;
const d = entry.data;
---
<a class:list={['r-card', { 'r-card--featured': featured }]} href={`/werk/${entry.id}/`}>
  <div class="r-card__media"><div class="r-card__placeholder"><span class="r-label">Beeld volgt</span></div></div>
  <div class="r-card__body">
    <div class="r-card__meta"><span class="r-label">{d.domein}</span><span class="r-label">{d.jaar}</span></div>
    <h3 class="r-card__title">{d.titel}<span class="arrow" aria-hidden="true">→</span></h3>
    <p class="r-card__text">{d.samenvatting}</p>
    <div class="r-card__tags">{featured && <span class="r-tag r-tag--highlight">Uitgelicht</span>}{d.categorieen.map((c) => <span class="r-tag">{c}</span>)}</div>
  </div>
</a>
