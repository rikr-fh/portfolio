---
// Achtergrond. Breed: kolommen naast elkaar. Smal: accordeon, één onderdeel tegelijk open.
import { achtergrond } from '../data/ervaring';
---
<section class="wrap sec" aria-labelledby="achtergrond-kop">
  <h2 class="sec-kop" id="achtergrond-kop">Achtergrond</h2>
  <div class="cols" data-accordeon="achtergrond">
    {achtergrond.map((kolom) => (
      <details open>
        <summary>
          <h3>{kolom.label}</h3>
          <svg class="ind" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </summary>
        <ul class="items">{kolom.items.map((item) => <li>{item}</li>)}</ul>
      </details>
    ))}
  </div>
</section>

<script>
  import '../scripts/accordeon';
</script>

<style>
  .cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; align-items: start; }
  details { border-top: var(--hairline) solid var(--ink); padding-top: var(--space-4); }
  h3 { font: 620 1.125rem/1.33 var(--font-display); letter-spacing: -.01em; }
  .items { margin-top: 12px; display: flex; flex-direction: column; gap: 10px; }
  .items li { font: 400 0.9375rem/1.47 var(--font-sans); color: var(--ink-muted); }

  @media (max-width: 1000px) { .cols { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) {
    .cols { grid-template-columns: 1fr; gap: 0; border-top: var(--hairline) solid var(--ink); }
    details { border-top: 0; border-bottom: var(--hairline) solid var(--line); padding-top: 0; }
    summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 56px; }
    .items { margin: 0 36px 18px 0; }
    .items li { font-size: 1rem; line-height: 1.5; }
  }
</style>
